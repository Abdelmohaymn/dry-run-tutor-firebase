{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Firebase #BuildHybridAI entry: this branch deploys ONLY the `firebase` env.
  // The top-level name is the firebase worker too, so a bare `wrangler deploy`
  // can never touch the Nebius (`dry-run-tutor`) or PayPal workers.
  "name": "dry-run-tutor-firebase",
  // Add "account_id" here if your Cloudflare login sees more than one account.
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (never committed): INSTALL_HMAC_SECRET, STT_KEY_GROQ (operator Groq
  // key for server-side speech-to-text) and TURNSTILE_SECRET (web-only routes).
  // No model key: every Gemini call is made by the app through Firebase AI Logic.
  "ratelimits": [
    { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
    { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    "firebase": {
      "name": "dry-run-tutor-firebase",
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Owner pastes the id from `npx wrangler d1 create dry-run-tutor-firebase`.
          "database_name": "dry-run-tutor-firebase",
          "database_id": "5fe2b620-15dd-4417-bfce-a9f75f36b021",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
        { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
